# Copy to .env.local and fill in. Never commit .env.local.
# Server-side only: used by the /api/ask endpoint, never sent to the browser.
OPENROUTER_API_KEY=
# Any OpenRouter model slug, e.g. one from https://openrouter.ai/models. Defaults to openrouter/auto.
OPENROUTER_MODEL=
# Used when the main model fails (e.g. no credits). Defaults to openrouter/free.
OPENROUTER_FALLBACK_MODEL=
