{
  "name": "agent-skills-os-site",
  "version": "0.1.0",
  "private": true,
  "description": "Website for universal-agent-skills. Next.js (static export), React, StyleX.",
  "author": "Rakibul Islam (https://rakibulism.space)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3310",
    "build": "next build",
    "preview": "next build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-adapters.mjs && next build",
    "check:adapters": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-adapters.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@stylexjs/stylex": "0.19.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "0.19.2",
    "@stylexjs/postcss-plugin": "0.19.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
